---
import type { ImageMetadata } from 'astro';

// Design Principles als Karten: farbige Fläche mit Icon, Titel und Stichpunkte (Figma: „Modul Karten“).
// In der MDX-Datei: <Principles slot="media" items={[{ title: '…', icon: importiertesSvg, color: '#45CA88', points: ['…', '…'] }, …]} />
interface Props { items: { title: string; icon: ImageMetadata; color: string; points: string[] }[] }
const { items } = Astro.props;
---
<ul class="principles" style={`--n: ${items.length}`}>
  {items.map(({ title, icon, color, points }) => (
    <li>
      <div class="principle-icon" style={`background: ${color}`}>
        <img src={icon.src} width={icon.width} height={icon.height} alt="" />
      </div>
      <div class="principle-text">
        <h4>{title}</h4>
        <ul>{points.map((point) => <li>{point}</li>)}</ul>
      </div>
    </li>
  ))}
</ul>

<style>
  .principles { width: 100%; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: var(--col-gap); margin: 0; padding: 0; list-style: none; }
  /* 4 gleich große Karten (Maße aus Figma): farbiges Feld 171:86 mit Icon (48 px), Titel 15, Stichpunkte 13 */
  .principles > li { display: flex; flex-direction: column; gap: 14px; padding: 12px 12px 24px; border-radius: var(--radius); background: var(--c-card); }
  .principle-icon { aspect-ratio: 171 / 86; display: flex; align-items: center; justify-content: center; border-radius: 8px; }
  .principle-icon img { width: 48px; height: 48px; object-fit: contain; }
  .principle-text { display: flex; flex-direction: column; gap: 10px; padding: 0 8px; }
  h4 { margin: 0; font-size: var(--fs-label); font-weight: 700; line-height: 1.2; }
  .principle-text ul { margin: 0; padding: 0; list-style: none; font-size: var(--fs-meta); line-height: 1.45; }
  .principle-text li::before { content: '→ '; }

  @media (max-width: 899px) { .principles { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 767px) { .principles { grid-template-columns: 1fr; } }
</style>
