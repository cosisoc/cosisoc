---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// Nummerierte Schritte, rechts daneben je ein Bild (Figma Konekt „Interaktionsprinzip“: Text 480, Bild 195 × 172, 32 Abstand).
// In der MDX-Datei mitten im Kapiteltext: <Steps items={[{ title: 'Platzieren', text: '…', image: bild, label: 'Alt-Text' }, …]} />
interface Props { items: { title: string; text: string; image: ImageMetadata; label: string }[] }
const { items } = Astro.props;
---
<ol class="steps">
  {items.map(({ title, text, image, label }, i) => (
    <li>
      <p><span class="step-title">{i + 1}&nbsp;&nbsp;{title}</span><br />{text}</p>
      <Image src={image} alt={label} widths={[image.width]} sizes="195px" />
    </li>
  ))}
</ol>

<style>
  .steps { width: 100%; max-width: 707px; margin: 16px 0 48px; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 32px; }
  li { display: grid; grid-template-columns: minmax(0, 480fr) minmax(0, 195fr); gap: 32px; align-items: center; }
  .step-title { font-weight: 500; }
  img { display: block; width: 100%; height: auto; aspect-ratio: 195 / 172; object-fit: contain; border-radius: 8px; }
</style>
