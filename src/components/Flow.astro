---
// Nutzungsablauf in Schritten: oben die Frage der Persona, darunter die Funktion der App (Figma: „Modul Flow“).
// labels = Beschriftungen in der Sprache der Seite.
// In der MDX-Datei: <Flow slot="media" labels={{ step: 'Schritt', question: 'Annas Frage', feature: 'Funktion' }} steps={[{ question: '…', feature: '…' }, …]} />
interface Props { steps: { question: string; feature: string }[]; labels: { step: string; question: string; feature: string } }
const { steps, labels } = Astro.props;
---
<ol class="flow" style={`--n: ${steps.length}`}>
  {steps.map(({ question, feature }, i) => (
    <li>
      <p class="flow-step">{labels.step} {i + 1}</p>
      <div class="flow-card is-question"><span>{labels.question}</span><p>„{question}“</p></div>
      <span class="flow-arrow" aria-hidden="true">↓</span>
      <div class="flow-card is-feature"><span>{labels.feature}</span><p>{feature}</p></div>
    </li>
  ))}
</ol>

<style>
  .flow { width: 100%; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: var(--col-gap); margin: 0; padding: 0; list-style: none; }
  li { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .flow-step { align-self: flex-start; font-size: 16px; color: var(--c-text-muted); }
  .flow-card { width: 100%; min-height: 150px; display: flex; flex-direction: column; gap: 6px; padding: 24px; border-radius: var(--radius); }
  .flow-card.is-question { background: #D4F2E8; }
  .flow-card.is-feature { background: #D6E3F5; }
  .flow-card span { font-size: 14px; color: var(--c-text-muted); }
  .flow-card p { font-size: 20px; font-weight: 500; line-height: 1.3; }
  .flow-arrow { font-size: 24px; }

  @media (max-width: 1023px) { .flow { grid-template-columns: 1fr 1fr; row-gap: 40px; } }
  @media (max-width: 767px) {
    .flow { grid-template-columns: 1fr; }
    .flow-card { min-height: 0; }
  }
</style>
