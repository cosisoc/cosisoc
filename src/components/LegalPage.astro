---
import Base from '../layouts/Base.astro';
import ImprintText from './legal/ImprintText.astro';
import PrivacyText from './legal/PrivacyText.astro';
import { copy } from '../i18n/copy';
import { otherLang, routes, useT, type Lang } from '../i18n/utils';

interface Props { lang: Lang; kind: 'imprint' | 'privacy' }
const { lang, kind } = Astro.props;
const t = useT(lang);
const title = t(kind === 'imprint' ? 'footer.imprint' : 'footer.privacy');
---
<Base
  lang={lang}
  title={`${title} – ${copy[lang].name}`}
  description={title}
  alternate={routes[kind][otherLang(lang)]}
>
  <article class="section legal">
    <a class="back" href={routes.home[lang]}>← {t('legal.back')}</a>
    <h1>{title}</h1>
    {lang === 'en' && <p class="note">This legal information is only available in German.</p>}
    <div class="text" lang="de">
      {kind === 'imprint' ? <ImprintText /> : <PrivacyText />}
    </div>
  </article>
</Base>

<style>
  .legal { display: flex; flex-direction: column; gap: 24px; max-width: 860px; min-height: 100vh; padding-top: calc(var(--nav-h) + 40px); }
  h1 { font-size: var(--fs-display); }
  .back { font-weight: 700; text-decoration: none; }
  .note { font-weight: 700; }
  .text { display: flex; flex-direction: column; gap: 16px; overflow-wrap: break-word; }
  .text :global(h2) { margin-top: 24px; font-size: var(--fs-sub); font-weight: var(--fw-sub); }
  .text :global(h3) { margin-top: 8px; font-size: inherit; }
  .text :global(h4) { margin: 0; font-size: inherit; font-weight: var(--fw-sub); }
  .text :global(ul) { display: flex; flex-direction: column; gap: 8px; padding-left: 20px; }
</style>
