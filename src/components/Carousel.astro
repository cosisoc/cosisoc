---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// Bildreihe zum Wischen, läuft rechts aus der Seite heraus; jedes Bild 4 Spalten breit, mit Bildunterschrift.
// Ohne Eingabe scrollt sie von allein weiter (carousel.js). In der MDX-Datei als Slot „media“ eines wide-Kapitels:
// <Carousel slot="media" images={[{ image: bild, label: 'Bildunterschrift' }, …]} />
interface Props { images: { image: ImageMetadata; label?: string }[] }
const { images } = Astro.props;
---
<div class="carousel">
  <ul class="carousel-track" data-carousel>
    {images.map(({ image, label }) => (
      <li class="carousel-item">
        <Image src={image} alt={label ?? ''} sizes="(min-width: 768px) 480px, 80vw" widths={[480, 960]} draggable="false" />
        {label && <p class="carousel-label">{label}</p>}
      </li>
    ))}
  </ul>
</div>

<script src="../scripts/carousel.js"></script>

<style>
  .carousel { width: calc(100% + var(--gutter)); margin-right: calc(-1 * var(--gutter)); }
  .carousel-track {
    display: flex;
    gap: var(--col-gap);
    margin: 0;
    padding: 0 var(--gutter) 0 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
  }
  .carousel-track::-webkit-scrollbar { display: none; }
  .carousel-track:global(.is-dragging) { scroll-snap-type: none; cursor: grabbing; }
  /* 4 von 12 Spalten: (Inhaltsbreite − 11 Abstände) / 3 + 3 Abstände */
  .carousel-item { flex: 0 0 calc(((100vw - 2 * var(--gutter) - 11 * var(--col-gap)) / 3 + 3 * var(--col-gap)) * var(--media-scale)); scroll-snap-align: start; }
  .carousel-item img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); user-select: none; }
  .carousel-label { margin-top: 10px; font-size: 16px; color: var(--c-text-muted); }

  @media (max-width: 767px) {
    .carousel-item { flex-basis: 80vw; }
  }
</style>
