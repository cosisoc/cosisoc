---
import { render } from 'astro:content';
import Media from './Media.astro';
import Chapter from './Chapter.astro';
import Model3D from './Model3D.astro';
import LangSwitch from './LangSwitch.astro';
import { projectUrl, otherLang, routes, useT, type Lang } from '../i18n/utils';
import type { Project } from '../lib/projects';
import { copy } from '../i18n/copy';
import '../styles/panel.css';

// Projektseite: Vollbild-Overlay mit eigener Leiste (COSI · Arbeiten · [Projekt] · DE/EN).
interface Props { lang: Lang; project: Project; next: Project; open: boolean }
const { lang, project: p, next, open } = Astro.props;
const t = useT(lang);
const c = copy[lang];
const { Content } = await render(p);
const d = p.data;
const home = routes.home[lang];
const back = d.kind === 'main'
  ? { label: t('nav.work'), href: `${home}#work`, section: c.work.label }
  : { label: t('nav.side'), href: `${home}#side`, section: c.side.label };
const facts = [
  [t('project.duration'), d.duration],
  [t('project.team'), d.team],
  [t('project.tools'), d.tools.join(', ')],
  [t('project.role'), d.role],
];
---
<div
  class:list={['panel', { 'is-open': open }]}
  id={`panel-${p.slug}`}
  role="dialog"
  aria-modal="true"
  aria-labelledby={`panel-title-${p.slug}`}
  inert={!open}
  data-slug={p.slug}
  data-url={projectUrl(lang, p.slug)}
  data-alt-url={projectUrl(otherLang(lang), p.slug)}
  data-title={`${d.title} – ${c.name}`}
>
  <article class="panel-sheet" tabindex="-1">
    <header class="panel-bar">
      <a class="bar-item bar-logo" href={home} data-panel-close>{c.logo}</a>
      <nav class="bar-crumbs">
        <a class="bar-item" href={back.href} data-panel-close>{back.label}</a>
        <span class="bar-item bar-current" aria-current="page">{d.title}</span>
      </nav>
      <LangSwitch lang={lang} alternate={projectUrl(otherLang(lang), p.slug)} />
    </header>

    <section class="panel-head grid">
      <div class="head-title">
        <p class="section-label">{back.section}</p>
        <h2 id={`panel-title-${p.slug}`}>{d.title}</h2>
      </div>
      <div class="head-text">
        <p class="head-short">{d.short}</p>
        <dl class="head-facts">
          {facts.map(([k, v]) => <div><dt>{k}:</dt> <dd>{v}</dd></div>)}
        </dl>
      </div>
      <div class="head-media">
        <Media media={d.hero} class="head-hero" />
        {d.model && <Model3D src={d.model.src} poster={d.model.poster} label={t('project.model')} />}
      </div>
    </section>

    <div class="chapters">
      <Content components={{ Chapter }} />
    </div>

    <a class="panel-next" href={projectUrl(lang, next.slug)} data-panel-open={next.slug}>
      <span class="next-label">{t('project.next')} →</span>
      <span class="next-title">{next.data.title}</span>
    </a>
  </article>
</div>
