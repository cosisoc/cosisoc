---
// Figma-Klickdummy: erst Platzhalter mit Knopf, der iframe lädt (und damit Figma kontaktiert) erst nach dem Klick.
// In der MDX-Datei: <Prototype slot="media" url="https://www.figma.com/proto/…" label="Titel" button="Prototyp starten" />
// Eigener Klickdummy aus public/ geht auch: url="/projects/…/index.html"
// Ohne url: Platzhalter mit dem Label, bis der Prototyp fertig ist.
// wide = breiter Rahmen über die volle Breite (Figma: 1432 × 800), auf dem Handy wieder im iPhone-Format.
// phone = eigener Klickdummy mit eigenem iPhone-Rahmen: lädt direkt, ohne grauen Kasten, Bildschirm 375 px breit,
//         label steht als Bildunterschrift darunter.
interface Props { url?: string; label: string; button?: string; wide?: boolean; phone?: boolean }
const { url, label, button, wide = false, phone = false } = Astro.props;
let src = url;
if (url && !url.startsWith('/')) {
  const embed = new URL(url);
  embed.hostname = 'embed.figma.com';
  embed.searchParams.delete('show-proto-sidebar');
  embed.searchParams.delete('t');
  embed.searchParams.set('embed-host', 'share');
  embed.searchParams.set('hide-ui', '1');
  embed.searchParams.set('hotspot-hints', '0');
  src = embed.href;
}
---
{phone && url ? (
  <figure class="proto-phone">
    <iframe src={src} title={label} loading="lazy"></iframe>
    <figcaption>{label}</figcaption>
  </figure>
) : url ? (
  <div class:list={['proto', { 'is-wide': wide }]} data-proto-src={src} data-proto-label={label}>
    <button class="btn proto-load" type="button">{button}</button>
  </div>
) : (
  <div class:list={['proto', 'proto-empty', { 'is-wide': wide }]}><span>{label}</span></div>
)}

<script src="../scripts/prototype.js"></script>

<style>
  /* iPhone-Frame 402 × 874 */
  .proto { position: relative; width: min(100%, 350px); aspect-ratio: 402 / 874; border-radius: var(--radius); background: var(--c-placeholder); }
  @media (min-width: 768px) { .proto.is-wide { aspect-ratio: 1432 / 800; } }
  .proto-empty { display: flex; align-items: center; justify-content: center; padding: 32px; text-align: center; color: var(--c-placeholder-text); }
  .proto-load { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); border: 0; cursor: pointer; }
  .proto :global(iframe) { display: block; width: 100%; height: 100%; border: 0; border-radius: var(--radius); }

  /* phone: 292 × 565 = Gerät des Klickdummys (426 × 898) auf Figma-Größe skaliert (Rahmen 260 × 548, Bildschirm 245 × 533),
     plus sein Innenabstand (32 px quer, 16 px hoch) */
  .proto-phone { margin: 0; width: 250px; max-width: 100%; } /* Figma: iPhone 484 px hoch */
  .proto-phone iframe { display: block; width: 100%; height: auto; aspect-ratio: 292 / 565; border: 0; background: transparent; }
  .proto-phone figcaption { margin-top: 8px; text-align: center; font-size: var(--fs-meta); color: var(--c-text-muted); }
</style>
