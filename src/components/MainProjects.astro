---
import Media from './Media.astro';
import SectionHead from './SectionHead.astro';
import { copy } from '../i18n/copy';
import { projectUrl, useT, type Lang } from '../i18n/utils';
import { projectNumber, type Project } from '../lib/projects';
import '../styles/projectwheel.css';

// Arbeiten: links Infos, in der Mitte das aktive Projekt groß (Bühne), rechts ragt ein kleines Rad mit
// Miniaturen aller Projekte aus dem Bildschirmrand. Logik in projectwheel.js, Aussehen in projectwheel.css.
interface Props { lang: Lang; projects: Project[] }
const { lang, projects } = Astro.props;
const t = useT(lang);
const items = projects.map((p) => {
  const d = p.data;
  // Vorschau = eigenes Vorschaumedium, sonst das Hero (z. B. das Konekt-Video)
  const media = d.preview.image || d.preview.video ? d.preview : d.hero;
  return { p, d, num: projectNumber(p), media };
});
const openLabel = (num: string, title: string) =>
  lang === 'de' ? `Projekt ${num}: ${title} öffnen` : `Project ${num}: open ${title}`;
---
<section class="section work" id="work" data-nav-section="work">
  <SectionHead label={copy[lang].work.label} title={copy[lang].work.title} />

  <div class="work-body grid" data-wheel-root tabindex="0" aria-roledescription="carousel" aria-label={copy[lang].work.title}>
    <div class="work-info">
      {items.map(({ d, num }, i) => (
        <div class="work-detail" data-info hidden={i !== 0}>
          <p class="work-name"><span>{num}</span> {d.title}</p>
          <p class="work-short">{d.short}</p>
          <dl class="work-specs">
            <div><dt>{t('project.when')}</dt><dd>{d.semester}</dd></div>
            <div><dt>{t('project.duration')}</dt><dd>{d.duration}</dd></div>
            <div><dt>{t('project.team')}</dt><dd>{d.team}</dd></div>
          </dl>
          <ul class="tags">{d.tags.map((tag) => <li class="tag">{tag}</li>)}</ul>
        </div>
      ))}
    </div>

    <div class="work-stage">
      {items.map(({ p, d, num, media }, i) => (
        <a
          class:list={['work-slide', { 'is-active': i === 0 }]}
          href={projectUrl(lang, p.slug)}
          data-panel-open={p.slug}
          data-cursor-label={t('project.cursor')}
          aria-label={openLabel(num, d.title)}
          tabindex={i === 0 ? 0 : -1}
        >
          <Media media={media} class="work-media" sizes="(min-width: 768px) 60vw, 100vw" />
        </a>
      ))}
    </div>

    <div class="wheel" data-wheel>
      <div class="wheel-spin">
        <span class="wheel-ring" aria-hidden="true"></span>
        {items.map(({ d, num, media }, i) => (
          <button type="button" class:list={['wheel-thumb', { 'is-active': i === 0 }]} data-i={i} aria-label={`${num} ${d.title}`}>
            <!-- Miniatur: bei Videos nur das Standbild, damit nicht alle gleichzeitig laufen -->
            <Media media={{ label: media.label, image: media.image ?? media.poster }} class="wheel-media" sizes="160px" />
            <span class="wheel-num">{num}</span>
          </button>
        ))}
      </div>
    </div>

    <p class="sr-only" aria-live="polite" data-live></p>
  </div>
</section>

<script src="../scripts/projectwheel.js"></script>
