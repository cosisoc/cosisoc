---
import Media from './Media.astro';
import SectionHead from './SectionHead.astro';
import { copy } from '../i18n/copy';
import { projectUrl, useT, type Lang } from '../i18n/utils';
import { projectNumber, type Project } from '../lib/projects';
import '../styles/cardstack.css';

// Arbeiten: beim Reinscrollen gleitet der Kartenstapel von der Mitte nach rechts, links blenden die Infos ein.
interface Props { lang: Lang; projects: Project[] }
const { lang, projects } = Astro.props;
const t = useT(lang);
const n = projects.length;
// Position relativ zur aktiven Karte (zirkulär): 0 = aktiv, 1 = rechts, n-1 = links, sonst verdeckt
const position = (i: number) => (i === 0 ? 'is-active' : i === 1 ? 'is-next' : i === n - 1 ? 'is-prev' : 'is-hidden');
const cardLabel = (num: string, title: string) =>
  lang === 'de' ? `Projekt ${num}: ${title} öffnen` : `Project ${num}: open ${title}`;
---
<section id="work" data-nav-section="work">
  <div class="work-track" data-pin data-pin-end="0.7">
    <div class="work-sticky section">
      <div class="work-move">
        <SectionHead label={copy[lang].work.label} title={copy[lang].work.title} />

        <div class="work-body grid" data-cardstack tabindex="0" aria-roledescription="carousel" aria-label={copy[lang].work.title}>
          <div class="work-info">
            {projects.map((p, i) => (
              <div class="stack-detail" data-info hidden={i !== 0}>
                <p class="stack-name">{projectNumber(p)} · {p.data.title}</p>
                <p class="stack-desc">{p.data.short}</p>
                <div class="stack-specs">
                  <dl>
                    <div><dt>{t('project.when')}</dt><dd>{p.data.semester}</dd></div>
                    <div><dt>{t('project.duration')}</dt><dd>{p.data.duration}</dd></div>
                    <div><dt>{t('project.team')}</dt><dd>{p.data.team}</dd></div>
                  </dl>
                  <ul class="tags">{p.data.tags.map((tag) => <li class="tag">{tag}</li>)}</ul>
                </div>
              </div>
            ))}
          </div>

          <div class="stack-area">
            <div class="stack">
              {projects.map((p, i) => (
                <a
                  class:list={['stack-card', position(i)]}
                  href={projectUrl(lang, p.slug)}
                  data-panel-open={i === 0 ? p.slug : undefined}
                  data-slug={p.slug}
                  aria-label={cardLabel(projectNumber(p), p.data.title)}
                  inert={position(i) === 'is-hidden'}
                  tabindex="-1"
                >
                  <Media media={p.data.preview} class="stack-media" sizes="470px" />
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="../scripts/cardstack.js"></script>
<script src="../scripts/scrollpin.js"></script>
