---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// Bildgruppe mit Bildunterschriften in der Inhaltsspalte.
// Bis 4 Bilder: eine Reihe, alle gleich hoch, jedes so breit wie sein Seitenverhältnis. 5 und mehr: 3er-Raster.
// ratio = Seitenverhältnis (für die ganze Gruppe oder pro Bild), sonst das des Bildes selbst; fit="contain" zeigt Grafiken ganz.
// video = Pfad in public/ statt Bild (läuft stumm in Schleife); ohne image und video: grauer Platzhalter.
// crop = Video im Rahmen zoomen/drehen wie in Figma: Breite/Höhe und Mittelpunkt in % des Rahmens, Drehung in Grad.
// In der MDX-Datei: <Figures slot="media" images={[{ image: a, label: 'Skizzen' }, …]} />
interface Crop { width: number; height: number; x: number; y: number; rotate: number }
interface Item { image?: ImageMetadata; video?: string; poster?: ImageMetadata; crop?: Crop; label: string; ratio?: string; fit?: 'cover' | 'contain' }
interface Props { images: Item[]; ratio?: string }
const { images, ratio } = Astro.props;
const grid = images.length > 4;
// „a / b“ → Zahl; ohne Angabe das Format des Bildes, sonst 4:3
const toNumber = (r: string) => { const [a, b] = r.split('/').map(Number); return b ? a / b : a; };
const ratioOf = ({ ratio: own, image, poster }: Item) => {
  const r = own ?? ratio;
  if (r) return toNumber(r);
  const img = image ?? poster;
  return img ? img.width / img.height : 4 / 3;
};
const widths = (image: ImageMetadata) => [...new Set([480, 960, 1600].map((w) => Math.min(w, image.width)))];
---
<div class:list={['figures', { 'is-grid': grid }]}>
  {images.map((item) => {
    const { image, video, poster, crop, label, fit } = item;
    const r = ratioOf(item);
    return (
      <figure style={`--r: ${r.toFixed(4)}`}>
        {video && crop
          ? <div class="figure-media is-cropped">
              <video src={video} poster={poster?.src} aria-label={label} autoplay muted loop playsinline
                style={`width: ${crop.width}%; height: ${crop.height}%; left: ${crop.x}%; top: ${crop.y}%; transform: translate(-50%, -50%) rotate(${crop.rotate}deg);`} />
            </div>
          : video
          ? <video class="figure-media" src={video} poster={poster?.src} aria-label={label} autoplay muted loop playsinline />
          : image
          ? <Image class:list={['figure-media', { 'is-contain': fit === 'contain' }]} src={image} alt={label} widths={widths(image)} sizes="(min-width: 768px) 852px, 100vw" />
          : <div class="figure-media is-empty" role="img" aria-label={label}></div>}
        <figcaption>{label}</figcaption>
      </figure>
    );
  })}
</div>

<style>
  /* Reihe: flex-grow = Seitenverhältnis → alle Bilder gleich hoch. Höchstens so breit, dass die Höhe begrenzt bleibt. */
  .figures { width: 100%; display: flex; gap: 24px; }
  figure { margin: 0; min-width: 0; flex: var(--r) 1 0; max-width: calc(var(--media-max-h) * var(--r)); }
  .figures.is-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 24px; }
  .is-grid figure { max-width: none; }
  .figure-media { display: block; width: 100%; height: auto; aspect-ratio: var(--r); object-fit: cover; border-radius: var(--radius); }
  .figure-media.is-contain { object-fit: contain; }
  .figure-media.is-empty { background: var(--c-placeholder); }
  .figure-media.is-cropped { position: relative; overflow: hidden; background: var(--c-placeholder); }
  .is-cropped video { position: absolute; max-width: none; object-fit: cover; }
  figcaption { margin-top: 8px; font-size: var(--fs-meta); line-height: var(--lh-lead); color: var(--c-text-muted); }

  @media (max-width: 767px) {
    .figures, .figures.is-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 16px; }
    figure { max-width: none; }
    .figures:not(.is-grid) figure:only-child, .figures figure:has(.is-contain) { grid-column: 1 / -1; }
  }
</style>
