---
// 3D-Modell (.glb aus public/projects/<slug>/): lädt automatisch, sobald es sichtbar wird.
// still = steht nur da, ohne Drehen und ohne Maus/Touch (z. B. als Vorschau hinter einem Link).
interface Props { src: string; label: string; still?: boolean }
const { src, label, still = false } = Astro.props;
---
<div class="model" data-model-src={src} data-model-alt={label} data-model-still={still || undefined}></div>

<script src="../scripts/model.js"></script>

<style>
  .model { aspect-ratio: 1; border-radius: var(--radius); background: #fff; }
  .model :global(model-viewer) { width: 100%; height: 100%; --poster-color: transparent; }
  .model[data-model-still] :global(model-viewer) { pointer-events: none; }
  .model :global(model-viewer)::part(default-progress-bar) { display: none; }
</style>
