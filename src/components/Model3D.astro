---
// 3D-Modell (.glb aus public/projects/<slug>/): lädt automatisch, sobald die Projektseite aufgeht.
interface Props { src: string; label: string }
const { src, label } = Astro.props;
---
<div class="model" data-model-src={src} data-model-alt={label}></div>

<script src="../scripts/model.js"></script>

<style>
  .model { aspect-ratio: 1; border-radius: var(--radius); background: #fff; }
  .model :global(model-viewer) { width: 100%; height: 100%; --poster-color: transparent; }
  .model :global(model-viewer)::part(default-progress-bar) { display: none; }
</style>
