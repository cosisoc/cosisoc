---
import Media from './Media.astro';
import { copy } from '../i18n/copy';
import type { Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
// TODO: Foto-Perspektiven (3–5) einsetzen; der Maus-Effekt kommt, sobald die Fotos da sind.
const perspectives = [1, 2, 3];
---
<section class="landing grid" id="top" data-nav-section="top">
  <div class="intro">
    <h1 data-reveal>{c.headline.map((line) => <span>{line}</span>)}</h1>
    <p class="subline" data-reveal style="--i:1">{c.subline}</p>
  </div>
  <div class="photo" data-perspectives data-reveal style="--i:2">
    {perspectives.map((n) => (
      <div class="perspective" data-perspective={n} hidden={n !== 1}>
        <Media media={{ label: `${c.photo} ${n}` }} class="photo-media" sizes="(min-width: 768px) 40vw, 100vw" />
      </div>
    ))}
  </div>
</section>

<style>
  .landing {
    min-height: 100vh;
    padding: var(--nav-h) var(--gutter) 0;
    align-items: center;
  }
  .intro { grid-column: 2 / 8; display: flex; flex-direction: column; gap: 32px; }
  h1 { font-size: var(--fs-display); text-transform: uppercase; line-height: 1.15; }
  h1 span { display: block; }
  .subline { font-weight: 700; }
  .photo { grid-column: 8 / 13; align-self: end; padding-left: 8%; }
  .photo :global(.photo-media) { aspect-ratio: 2 / 3; border-radius: 0; }

  @media (max-width: 767px) {
    .landing { padding-top: calc(var(--nav-h) + 24px); row-gap: 40px; }
    .photo { padding-left: 0; }
  }
</style>
