---
import Media from './Media.astro';
import { copy } from '../i18n/copy';
import type { Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
// TODO: Foto-Perspektiven (3–5) einsetzen; der Maus-Effekt kommt später.
const perspectives = [1, 2, 3];
---
<section class="section landing" id="top">
  <div class="photo" data-perspectives>
    {perspectives.map((n) => (
      <div class="perspective" data-perspective={n} hidden={n !== 1}>
        <Media media={{ label: `${c.photo} ${n}` }} class="photo-media" />
      </div>
    ))}
  </div>
  <div class="intro">
    <span class="eyebrow">{c.role}</span>
    <h1>{c.name}</h1>
    <p class="claim">{c.claim}</p>
    <div>
      <span class="label">{c.interestsTitle}</span>
      <ul class="tags">
        {c.interests.map((i) => <li class="tag">{i}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .landing {
    min-height: calc(100vh - var(--nav-h));
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
  }
  .photo :global(.photo-media) { aspect-ratio: 4 / 5; }
  .intro { display: flex; flex-direction: column; gap: 24px; }
  h1 { font-size: clamp(48px, 7vw, 96px); }
  .claim { font-size: clamp(20px, 2.2vw, 28px); line-height: 1.3; max-width: 32ch; }
  .label { display: block; margin-bottom: 8px; }

  @media (max-width: 767px) {
    .landing { grid-template-columns: 1fr; min-height: 0; }
  }
</style>
