---
import Media from './Media.astro';
import { copy } from '../i18n/copy';
import type { Lang } from '../i18n/utils';
import foto from '../assets/foto.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
// TODO: Vorerst nur die mittlere Perspektive; der Maus-Effekt kommt, sobald die übrigen Fotos da sind.
---
<section class="landing grid" id="top" data-nav-section="top">
  <div class="intro">
    <h1 data-reveal>{c.headline.map((line, i) => i === c.headline.length - 1 && line.endsWith('.')
      ? <span>{line.slice(0, -1)}<span class="dot">.</span></span>
      : <span>{line}</span>)}</h1>
    <p class="subline" data-reveal style="--i:1">{c.subline}</p>
  </div>
  <div class="photo" data-reveal style="--i:2">
    <Media media={{ label: c.photo, image: foto }} class="photo-media" sizes="(min-width: 768px) 40vw, 100vw" />
  </div>
</section>

<style>
  /* Die Mittelzeile hält den Text mittig; das Foto startet mit ihr und läuft bis zur Unterkante. */
  .landing {
    min-height: 100vh;
    padding: var(--nav-h) var(--gutter) 0;
    grid-template-rows: 1fr auto 1fr;
  }
  .intro { grid-column: 1 / 9; grid-row: 2; display: flex; flex-direction: column; gap: 32px; }
  h1 { font-family: var(--f-hero); font-size: var(--fs-hero); text-transform: uppercase; line-height: var(--lh-display); }
  h1 span { display: block; }
  h1 .dot { display: inline; color: var(--c-accent); }
  .subline { font-size: var(--fs-sub); line-height: var(--lh-lead); font-weight: var(--fw-sub); max-width: 560px; }
  /* margin-top: Abstand von der Zeilenbox bis zur Oberkante der Großbuchstaben */
  .photo { grid-column: 9 / 13; grid-row: 2 / 4; position: relative; margin-top: calc(var(--fs-hero) * 0.17); }
  .photo :global(.photo-media) { position: absolute; inset: 0; height: 100%; border-radius: 0; object-position: top; filter: grayscale(1); }

  @media (max-width: 767px) {
    .landing { padding-top: calc(var(--nav-h) + 24px); row-gap: 40px; grid-template-rows: auto 1fr; }
    .intro, .photo { grid-row: auto; }
    .photo { padding-left: 0; margin-top: 0; align-self: end; }
    .photo :global(.photo-media) { position: static; height: auto; }
  }
</style>
