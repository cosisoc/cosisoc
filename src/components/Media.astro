---
import { Image, getImage } from 'astro:assets';
import type { Media } from '../lib/projects';

// Zeigt Video, Bild oder – solange nichts gesetzt ist – eine Platzhalter-Box mit Label.
interface Props { media: Media; class?: string; sizes?: string }
const { media, class: className, sizes = '(min-width: 768px) 900px, 100vw' } = Astro.props;
// Vorschaubild des Videos verkleinert und als WebP (sonst käme z. B. ein 1,7-MB-PNG ungefiltert an)
const poster = media.poster && (await getImage({ src: media.poster, width: Math.min(1400, media.poster.width), format: 'webp' })).src;
---
{media.video ? (
  <video
    class:list={['media', className]}
    src={media.video}
    poster={poster}
    aria-label={media.label}
    controls={media.controls}
    preload="none" data-autoplay muted loop playsinline
  />
) : media.image ? (
  <Image class:list={['media', className]} src={media.image} alt={media.label} sizes={sizes} widths={[480, 900, 1400]} />
) : (
  <div class:list={['media', 'media-placeholder', className]}>
    <span>{media.label}</span>
  </div>
)}

<script src="../scripts/lazy-video.js"></script>

<style>
  .media {
    width: 100%;
    border-radius: var(--radius);
    object-fit: cover;
  }
  .media-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 160px;
    padding: 16px;
    background: var(--c-placeholder);
    color: var(--c-placeholder-text);
    text-align: center;
  }
</style>
