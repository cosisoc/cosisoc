---
import { Image } from 'astro:assets';
import type { Media } from '../lib/projects';

// Zeigt Video, Bild oder – solange nichts gesetzt ist – eine Platzhalter-Box mit Label.
// Das Vorschaubild eines Videos kann ein importiertes Bild oder ein Pfad aus public/ sein.
interface Props { media: Omit<Media, 'poster'> & { poster?: Media['poster'] | string }; class?: string; sizes?: string }
const { media, class: className, sizes = '(min-width: 768px) 900px, 100vw' } = Astro.props;
---
{media.video ? (
  <video
    class:list={['media', className]}
    src={media.video}
    poster={typeof media.poster === 'string' ? media.poster : media.poster?.src}
    aria-label={media.label}
    autoplay muted loop playsinline
  />
) : media.image ? (
  <Image class:list={['media', className]} src={media.image} alt={media.label} sizes={sizes} widths={[480, 900, 1400]} />
) : (
  <div class:list={['media', 'media-placeholder', className]}>
    <span>{media.label}</span>
  </div>
)}

<style>
  .media {
    width: 100%;
    border-radius: var(--radius);
    object-fit: cover;
  }
  .media-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 160px;
    padding: 16px;
    background: var(--c-placeholder);
    font-size: var(--fs-s);
    color: var(--c-placeholder-text);
    text-align: center;
  }
</style>
