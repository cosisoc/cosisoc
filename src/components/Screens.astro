---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// App-Screens in Gruppen nebeneinander, je Gruppe eine Bildunterschrift (Figma: zwei Screens pro Abbildung).
// In der MDX-Datei: <Screens slot="media" groups={[{ images: [screenA, screenB], label: 'Bildunterschrift' }, …]} />
interface Props { groups: { images: ImageMetadata[]; label: string }[] }
const { groups } = Astro.props;
---
<div class="screens" style={`--n: ${groups.length}`}>
  {groups.map(({ images, label }) => (
    <figure>
      <div class="screens-row">
        {images.map((image) => <Image src={image} alt={label} sizes="200px" widths={[200, image.width]} />)}
      </div>
      <figcaption>{label}</figcaption>
    </figure>
  ))}
</div>

<style>
  .screens { width: 100%; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 32px var(--col-gap); }
  figure { margin: 0; min-width: 0; }
  .screens-row { display: flex; justify-content: center; gap: 12px; }
  img { display: block; min-width: 0; width: 100%; max-width: 200px; height: auto; }
  figcaption { margin-top: 10px; font-size: 16px; color: var(--c-text-muted); }

  @media (max-width: 767px) { .screens { grid-template-columns: 1fr; } }
</style>
