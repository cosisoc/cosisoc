---
import { copy } from '../i18n/copy';
import { useT, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const a = copy[lang].about;
---
<section class="section" id="about">
  <div class="section-head">
    <div>
      <span class="eyebrow">{t('nav.about')}</span>
      <h2>{t('about.title')}</h2>
    </div>
  </div>
  <div class="grid">
    <p class="intro">{a.intro}</p>
    <div>
      <span class="label">{a.skillsTitle}</span>
      <ul class="tags">{a.skills.map((s) => <li class="tag">{s}</li>)}</ul>
    </div>
    <div>
      <span class="label">{a.toolsTitle}</span>
      <ul class="tags">{a.tools.map((s) => <li class="tag">{s}</li>)}</ul>
    </div>
    <div>
      <span class="label">{a.contactTitle}</span>
      <a class="mail" href={`mailto:${a.mail}`}>{a.mail}</a>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 32px;
  }
  .intro { grid-column: 1 / -1; font-size: clamp(20px, 2.2vw, 28px); line-height: 1.3; max-width: 40ch; }
  .label { display: block; margin-bottom: 10px; }
  .mail { font-size: 20px; font-weight: 500; }

  @media (max-width: 767px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
