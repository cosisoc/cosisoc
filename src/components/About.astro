---
import SectionHead from './SectionHead.astro';
import { copy } from '../i18n/copy';
import type { Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const a = copy[lang].about;
---
<section class="section about" id="about" data-nav-section="about">
  <SectionHead label={a.label} title={a.title} />
  <div class="grid about-body">
    <p class="intro">{a.intro}</p>
    <div class="lists">
      <div>
        <h3>{a.skillsTitle}</h3>
        <ul class="tags">{a.skills.map((s) => <li class="tag">{s}</li>)}</ul>
      </div>
      <div>
        <h3>{a.toolsTitle}</h3>
        <ul class="tags">{a.tools.map((s) => <li class="tag">{s}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about { min-height: 100vh; padding-top: calc(var(--section-top) + 160px); }
  .about-body { margin-top: 40px; row-gap: 48px; }
  .intro { grid-column: 1 / 6; font-size: var(--fs-l); font-weight: 700; line-height: 1.25; }
  .lists { grid-column: 1 / 6; display: flex; flex-direction: column; gap: 24px; }
  h3 { font-size: var(--fs-m); margin-bottom: 12px; }
</style>
