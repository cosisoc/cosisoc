---
import type { ImageMetadata } from 'astro';
import Media from './Media.astro';

// Kapitel im Projektdetail (Figma-Vorlage), immer offen: Kopf mit Nummer + Titel (Spalte 1–3) und Kernsatz (Spalte 4–10),
// darunter Text und Bild nebeneinander. Die Nummer zählt CSS automatisch hoch (panel.css), das Bild wechselt die Seite.
// wide = Text unter dem Kernsatz im Kopf, Bild/Medium darunter über die volle Breite (Video, Karussell, Live-Demo).
//        Ohne Bild, Video, Label und Slot „media“ hat ein wide-Kapitel kein Medium.
// In der MDX-Datei: <Chapter title="…" teaser="…" image={importiertesBild} label="Alt-Text">Details</Chapter>
// Videos mit controls bekommen Bedienleiste und Ton (z. B. ein ganzer Film).
// Grafiken mit fit="contain" werden ganz gezeigt statt auf 4:3 beschnitten.
// tint = Kapitel auf beigem Grund über die volle Breite.
// Eigener Inhalt statt Bild (z. B. <Prototype slot="media" …/>) kommt in den Slot „media“; mehrere Elemente stehen untereinander.
// statement = Kernsatz groß wie eine Überschrift (Figma: „Leitsatz“). id = Sprungziel, z. B. für den Knopf im Projektkopf.
// Nur mit wide: split = Text und Slot „media“ nebeneinander unter dem Kernsatz; inset = Medium bündig mit dem Text (Spalte 4–12);
// pair = zwei Elemente im Slot „media“ nebeneinander (je 6 Spalten).
// beside = Kernsatz und Text links (520 px), Slot „media“ rechts daneben, oben bündig (z. B. Prototyp im Handy).
interface Props { title: string; teaser: string; image?: ImageMetadata; video?: string; label?: string; fit?: 'cover' | 'contain'; wide?: boolean; controls?: boolean; tint?: boolean; statement?: boolean; id?: string; split?: boolean; inset?: boolean; pair?: boolean; beside?: boolean }
const { title, teaser, image, video, label, fit = 'cover', wide = false, controls, tint = false, statement = false, id, split = false, inset = false, pair = false, beside = false } = Astro.props;
const custom = Astro.slots.has('media');
const hasMedia = custom || image || video || label || !wide;
---
<section class:list={['chapter', { 'is-wide': wide, 'is-tinted': tint, 'is-statement': statement, 'is-split': split, 'is-inset': inset, 'is-pair': pair, 'is-beside': beside }]} id={id}>
  <div class="chapter-head grid">
    <h3 class="chapter-side">
      <span class="chapter-num" aria-hidden="true"></span>
      <span class="chapter-title">{title}</span>
    </h3>
    <div class="chapter-main">
      <p class="chapter-teaser">{teaser}</p>
      {wide && !split && <div class="chapter-more"><slot /></div>}
      {wide && beside && <div class="chapter-custom"><slot name="media" /></div>}
      {wide && split && (
        <div class="chapter-split">
          <div class="chapter-more"><slot /></div>
          <div class="chapter-custom"><slot name="media" /></div>
        </div>
      )}
    </div>
  </div>
  {(!wide || hasMedia) && !split && !beside && (
    <div class="chapter-body grid">
      {!wide && <div class="chapter-text chapter-more"><slot /></div>}
      {hasMedia && (custom
        ? <div class="chapter-custom"><slot name="media" /></div>
        : <Media media={{ label: label ?? `[Bild/Video: ${title}]`, image, video, controls }} class={`chapter-media is-${fit}`} />)}
    </div>
  )}
</section>
