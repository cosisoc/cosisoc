---
import type { ImageMetadata } from 'astro';
import Media from './Media.astro';

// Kapitel im Projektdetail: zugeklappt nur Nummer + Titel, „+“ klappt Text und Bild auf.
// Die Nummer zählt CSS automatisch hoch (panel.css), das Bild wechselt von Kapitel zu Kapitel die Seite.
// In der MDX-Datei: <Chapter title="…" teaser="…" image={importiertesBild} label="Alt-Text">Details</Chapter>
interface Props { title: string; teaser: string; image?: ImageMetadata; video?: string; label?: string }
const { title, teaser, image, video, label = `[Bild/Video: ${title}]` } = Astro.props;
---
<details class="chapter">
  <summary class="chapter-row">
    <span class="chapter-num" aria-hidden="true"></span>
    <span class="chapter-title">{title}</span>
    <span class="chapter-icon" aria-hidden="true"></span>
  </summary>
  <div class="chapter-body grid">
    <div class="chapter-text">
      <p class="chapter-teaser">{teaser}</p>
      <div class="chapter-more"><slot /></div>
    </div>
    <Media media={{ label, image, video }} class="chapter-media" />
  </div>
</details>
