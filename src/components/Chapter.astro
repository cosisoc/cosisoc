---
import type { ImageMetadata } from 'astro';
import Media from './Media.astro';

// Kapitel im Projektdetail (Figma „Vorschlag Layout“): links in der Label-Spalte Nummer + Titel,
// rechts in der Inhaltsspalte Kernsatz, Text und darunter das Medium. Die Nummer zählt CSS (chapters.css).
// Hochformat (Bild höchstens 1,3-mal so breit wie hoch) oder beside: Text links, Medium rechts daneben.
// In der MDX-Datei: <Chapter title="…" teaser="…" image={importiertesBild} label="Alt-Text">Details</Chapter>
// wide = ohne Medium kein Platzhalter. Eigener Inhalt statt Bild (z. B. <Figures slot="media" …/>) kommt in den Slot „media“.
// controls = Video mit Bedienleiste und Ton, poster = Vorschaubild des Videos. fit="contain" zeigt Grafiken ganz statt beschnitten.
// tint = Kapitel auf beigem Grund über die volle Breite. statement = Kernsatz groß wie eine Überschrift.
// id = Sprungziel, z. B. für den Knopf im Projektkopf.
interface Props { title: string; teaser: string; image?: ImageMetadata; video?: string; poster?: ImageMetadata; label?: string; fit?: 'cover' | 'contain'; wide?: boolean; controls?: boolean; tint?: boolean; statement?: boolean; id?: string; beside?: boolean }
const { title, teaser, image, video, poster, label, fit = 'cover', wide = false, controls, tint = false, statement = false, id, beside = false } = Astro.props;
const custom = Astro.slots.has('media');
const hasMedia = custom || image || video || label || !wide;
const portrait = beside || (!!image && image.width / image.height <= 1.3);
---
<section class:list={['chapter', 'axes', { 'is-tinted': tint, 'is-statement': statement, 'is-portrait': portrait && hasMedia }]} id={id}>
  <h3 class="chapter-side">
    <span class="chapter-num" aria-hidden="true"></span>
    <span class="chapter-title">{title}</span>
  </h3>
  <div class="chapter-main">
    <p class="chapter-teaser">{teaser}</p>
    <div class="chapter-more"><slot /></div>
    {hasMedia && (custom
      ? <div class="chapter-custom"><slot name="media" /></div>
      : <Media media={{ label: label ?? `[Bild/Video: ${title}]`, image, video, poster, controls }} class={`chapter-media is-${fit}`} />)}
  </div>
</section>
