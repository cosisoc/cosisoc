---
import Media from './Media.astro';
import SectionHead from './SectionHead.astro';
import { copy } from '../i18n/copy';
import { projectUrl, useT, type Lang } from '../i18n/utils';
import type { Project } from '../lib/projects';

// Nebenprojekte: Karten liegen als gedrehter Stapel und fächern beim Scrollen ungeordnet auf.
interface Props { lang: Lang; projects: Project[] }
const { lang, projects } = Astro.props;
const t = useT(lang);

// Endpositionen im 12-Spalten-Raster: Karten à 4 Spalten ab Spalte 1, 5 und 9 (c = Startspalte ab 0),
// in der Höhe versetzt (y in % der Bühne). Der Stapel liegt mittig direkt unter der Überschrift.
const PILE = { c: 4, y: 30 };
const SPOTS = [
  { c: 0, y: 30, r: -7 },
  { c: 4, y: 42, r: 8 },
  { c: 8, y: 26, r: -2 },
];
const style = (i: number) => {
  const s = SPOTS[i % SPOTS.length];
  return `--c:${s.c}; --y:${s.y}; --dc:${PILE.c - s.c}; --dy:${PILE.y - s.y}; --r:${s.r}; --i:${i}; z-index:${projects.length - i}`;
};
---
<section id="side" class="dotted" data-nav-section="side">
  <div class="side-track" data-pin data-pin-start="0.5">
    <div class="side-sticky section">
      <SectionHead label={copy[lang].side.label} title={copy[lang].side.title} />
      <ul class="side-stage">
        {projects.map((p, i) => (
          <li class="side-card" style={style(i)}>
            <a href={projectUrl(lang, p.slug)} data-panel-open={p.slug} data-cursor-label={t('project.cursor')}>
              <Media media={p.data.preview} class="side-media" sizes="440px" />
              <h3>{p.data.title}</h3>
              <p>{p.data.short}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script src="../scripts/scrollpin.js"></script>

<style>
  .side-track { --p: 1; }
  .side-stage { display: flex; flex-wrap: wrap; gap: 32px; }
  .side-card { width: min(318px, 100%); }
  .side-card:nth-child(even) { margin-top: 64px; }
  .side-card a {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px 14px 20px;
    background: var(--c-card);
    color: var(--c-text);
    text-decoration: none;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
    transition: transform var(--dur) var(--ease);
  }
  .side-card a:hover { transform: translateY(-6px); }
  .side-card :global(.side-media) { aspect-ratio: 4 / 3; border-radius: 0; }
  /* Videos nie beschneiden: ganz, im eigenen Format */
  .side-card :global(video.side-media) { aspect-ratio: auto; object-fit: contain; }
  h3 { font-size: var(--fs-body); }
  p { line-height: var(--lh-body); }

  /* Gepinnt: Bühne füllt den Bildschirm, Karten wandern vom Stapel an ihre Plätze */
  /* Animation endet genau, wenn der Abschnitt weiterscrollt (keine Leerstrecke danach) */
  :global(.pins) .side-track { height: 172vh; }
  :global(.pins) .side-sticky { position: sticky; top: 0; height: 100vh; overflow: clip; }
  :global(.pins) .side-stage {
    position: absolute;
    inset: 0;
    margin: 0;
    container-type: size;
    pointer-events: none;
  }
  :global(.pins) .side-card {
    /* jede Karte startet etwas später → natürliches Auffächern */
    --q: clamp(0, (var(--p) - var(--i) * 0.12) / 0.76, 1);
    /* Spaltenbreite des 12er-Rasters innerhalb der Bühne (volle Breite inkl. Rand) */
    --col: calc((100cqw - 2 * var(--gutter) - 11 * var(--col-gap)) / 12);
    --step: calc(var(--col) + var(--col-gap));
    position: absolute;
    left: calc(var(--gutter) + var(--c) * var(--step));
    top: calc(var(--y) * 1%);
    width: min(4 * var(--col) + 3 * var(--col-gap), 44cqh);
    margin: 0;
    pointer-events: auto;
    transform:
      translate(calc((1 - var(--q)) * var(--dc) * var(--step)), calc((1 - var(--q)) * var(--dy) * 1cqh))
      rotate(calc((1 - var(--q)) * var(--r) * 1deg));
  }
</style>
