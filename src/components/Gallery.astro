---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// Mehrere Bilder in einem Kapitel, 2 Spalten. In der MDX-Datei als Slot „media“:
// <Gallery slot="media" images={[{ image: bild, label: 'Alt-Text' }, …]} />
interface Props { images: { image: ImageMetadata; label: string }[] }
const { images } = Astro.props;
---
<div class="gallery">
  {images.map(({ image, label }) => (
    <Image src={image} alt={label} sizes="(min-width: 768px) 450px, 50vw" widths={[480, 900]} />
  ))}
</div>

<style>
  .gallery { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); }
</style>
