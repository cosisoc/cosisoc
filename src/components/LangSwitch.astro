---
import { useT, type Lang } from '../i18n/utils';

interface Props { lang: Lang; alternate: string }
const { lang, alternate } = Astro.props;
const t = useT(lang);
---
<div class="lang" role="group" aria-label={t('nav.lang')}>
  {lang === 'de'
    ? <><span aria-current="true">DE</span> / <a href={alternate} hreflang="en" data-lang-alt>EN</a></>
    : <><a href={alternate} hreflang="de" data-lang-alt>DE</a> / <span aria-current="true">EN</span></>}
</div>

<style>
  .lang { display: inline-flex; align-items: center; gap: 0.3em; font-size: var(--fs-m); font-weight: 700; white-space: nowrap; }
  a { color: var(--c-text-muted); text-decoration: none; }
  a:hover { color: var(--c-accent); }
</style>
