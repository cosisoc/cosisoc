---
// Layout-Raster zum Ausrichten: Shift + 1 blendet es ein/aus. Wird nur in `npm run dev` eingebunden (Base.astro).
---
<div class="grid-overlay" data-grid-overlay hidden aria-hidden="true">
  {Array.from({ length: 12 }, () => <span />)}
</div>

<script>
  const overlay = document.querySelector<HTMLElement>('[data-grid-overlay]')!;
  addEventListener('keydown', (e) => {
    if (!e.shiftKey || e.code !== 'Digit1') return;
    if ((e.target as HTMLElement).closest('input, textarea, [contenteditable]')) return;
    overlay.hidden = !overlay.hidden;
  });
</script>

<style>
  .grid-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    padding: 0 var(--gutter);
    pointer-events: none;
    /* Grundlinienraster: alle 8 px eine Linie */
    background-image: repeating-linear-gradient(to bottom, transparent 0 7px, rgb(255 0 80 / 0.15) 7px 8px);
  }
  .grid-overlay[hidden] { display: none; }
  .grid-overlay span { background: rgb(255 0 80 / 0.08); }

  @media (max-width: 767px) {
    .grid-overlay { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .grid-overlay span:nth-child(n + 5) { display: none; }
  }
</style>
