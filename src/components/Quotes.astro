---
// Zitate aus der Recherche als Karten nebeneinander (Figma: „Modul Zitate“).
// In der MDX-Datei als Slot „media“: <Quotes slot="media" quotes={[{ text: '…', source: 'Name, Alter · App Store' }, …]} />
// cols = Karten pro Reihe (Standard: alle nebeneinander), z. B. cols={2} für ein 2×2-Raster.
interface Props { quotes: { text: string; source: string }[]; cols?: number }
const { quotes, cols = quotes.length } = Astro.props;
---
<ul class="quotes" style={`--n: ${cols}`}>
  {quotes.map(({ text, source }) => (
    <li>
      <blockquote>„{text}“</blockquote>
      <p>{source}</p>
    </li>
  ))}
</ul>

<style>
  .quotes { width: 100%; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: var(--col-gap); margin: 0; padding: 0; list-style: none; }
  li { display: flex; flex-direction: column; justify-content: space-between; gap: 24px; padding: 28px; border-radius: var(--radius); background: var(--c-sand); }
  blockquote { margin: 0; font-size: 22px; font-weight: 500; line-height: 1.35; }
  p { font-size: 16px; color: var(--c-text-muted); }

  @media (max-width: 1023px) { .quotes { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 767px) { .quotes { grid-template-columns: 1fr; } }
</style>
