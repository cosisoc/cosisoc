---
import { copy } from '../i18n/copy';
import { routes, useT, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<footer class="footer">
  <span>© {new Date().getFullYear()} {copy[lang].name}</span>
  <a href={routes.imprint[lang]}>{t('footer.imprint')}</a>
  <a href={routes.privacy[lang]}>{t('footer.privacy')}</a>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    padding: 32px var(--gutter);
    border-top: 1px solid var(--c-border-soft);
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--c-text-muted);
  }
  span { margin-right: auto; }
  a { color: var(--c-text-muted); }
  a:hover { color: var(--c-accent); }
</style>
