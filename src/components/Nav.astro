---
import LangSwitch from './LangSwitch.astro';
import { copy } from '../i18n/copy';
import { routes, useT, type Lang } from '../i18n/utils';

interface Props { lang: Lang; alternate: string }
const { lang, alternate } = Astro.props;
const t = useT(lang);
const home = routes.home[lang];
const items = [
  ['work', t('nav.work')],
  ['side', t('nav.side')],
  ['about', t('nav.about')],
  ['contact', t('nav.contact')],
];
---
<header class="nav grid" data-nav>
  <!-- Grüner Tab: gleitet zum aktiven Abschnitt (navspy.js) -->
  <span class="nav-tab" aria-hidden="true"></span>
  <!-- TODO: handgezeichnetes Logo statt Text -->
  <a class="nav-item nav-logo" href={`${home}#top`} data-nav-target="top">{copy[lang].logo}</a>
  <nav aria-label={t('nav.label')}>
    <ul>
      {items.map(([id, label]) => (
        <li><a class="nav-item" href={`${home}#${id}`} data-nav-target={id}>{label}</a></li>
      ))}
    </ul>
  </nav>
  <LangSwitch lang={lang} alternate={alternate} />
</header>

<script src="../scripts/navspy.js"></script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    height: var(--nav-h);
    align-items: center;
    padding: 0 var(--gutter);
    pointer-events: none;
  }
  .nav > * { pointer-events: auto; }
  .nav-tab {
    position: absolute;
    top: 0;
    left: 0;
    height: var(--nav-h);
    width: 0;
    border-radius: 0 0 var(--radius-tab) var(--radius-tab);
    background: var(--c-accent);
    opacity: 0;
    pointer-events: none;
  }
  :global(.nav.is-ready) .nav-tab {
    transition: transform var(--dur) var(--ease), width var(--dur) var(--ease), opacity var(--dur) ease;
  }
  .nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: var(--nav-h);
    padding: 0 24px;
    font-weight: 700;
    text-decoration: none;
    color: var(--c-text);
    transition: color var(--dur) ease;
  }
  .nav-item:hover { color: var(--c-accent); }
  .nav-item:global(.is-active) { color: var(--c-on-accent); }
  .nav-logo { grid-column: 1 / 5; justify-self: start; margin-left: -24px; }
  nav { grid-column: 6 / 11; }
  ul { display: flex; flex-wrap: nowrap; margin-left: -24px; }
  .nav :global(.lang) { grid-column: 11 / 13; justify-self: end; }

  @media (max-width: 1100px) {
    .nav-item { padding: 0 14px; }
    nav { grid-column: 4 / 11; }
  }
  @media (max-width: 767px) {
    .nav { display: flex; justify-content: space-between; }
    nav { display: none; } /* TODO: Mobile-Navigation */
  }
</style>
