---
import LangSwitch from './LangSwitch.astro';
import { copy } from '../i18n/copy';
import { routes, useT, type Lang } from '../i18n/utils';

interface Props { lang: Lang; alternate: string }
const { lang, alternate } = Astro.props;
const t = useT(lang);
const home = routes.home[lang];
---
<header class="nav">
  <!-- TODO: handgezeichnetes Logo statt Name -->
  <a class="nav-logo" href={home}>{copy[lang].name}</a>
  <nav aria-label="Hauptnavigation">
    <ul>
      <li><a href={`${home}#main-projects`}>{t('nav.main')}</a></li>
      <li><a href={`${home}#side-projects`}>{t('nav.side')}</a></li>
      <li><a href={`${home}#about`}>{t('nav.about')}</a></li>
    </ul>
  </nav>
  <LangSwitch lang={lang} alternate={alternate} />
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 0 var(--gutter);
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--c-border-soft);
  }
  .nav-logo {
    font-weight: 600;
    color: var(--c-text);
    text-decoration: none;
    margin-right: auto;
  }
  ul { display: flex; gap: 28px; }
  ul a {
    font-size: 15px;
    color: var(--c-text-soft);
    text-decoration: none;
  }
  ul a:hover { color: var(--c-accent); }

  @media (max-width: 767px) {
    .nav { gap: 16px; }
    nav { display: none; } /* TODO: Mobile-Navigation */
  }
</style>
