---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/interaction.css';
import Nav from '../components/Nav.astro';
import GridOverlay from '../components/GridOverlay.astro';
import { routes, otherLang, useT, type Lang } from '../i18n/utils';
import { copy } from '../i18n/copy';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** URL derselben Seite in der anderen Sprache */
  alternate: string;
  /** Titel der Startseite (für panel.js, wenn ein Projekt geschlossen wird) */
  homeTitle?: string;
}

const { lang, title, description, alternate, homeTitle = title } = Astro.props;
const alt = otherLang(lang);
---
<!doctype html>
<html
  lang={lang}
  data-home={routes.home[lang]}
  data-home-title={homeTitle}
  data-home-alt={routes.home[alt]}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="alternate" hreflang={alt} href={alternate} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div data-page>
      <Nav lang={lang} alternate={alternate} />
      <main><slot /></main>
    </div>
    <slot name="panels" />
    {import.meta.env.DEV && <GridOverlay />}
    <script>
      // „Bewegung reduzieren“ respektieren: Autoplay-Videos anhalten
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((v) => v.pause());
      }
      // Bilder und Links nicht herausziehen (Firefox ignoriert -webkit-user-drag)
      addEventListener('dragstart', (e) => e.preventDefault());
      // Kein Rechtsklick-Menü, außer auf Mail und Rechtstexten (zum Kopieren)
      // TEMP: Rechtsklick erlaubt – vor Deployment wieder aktivieren
      // addEventListener('contextmenu', (e) => {
      //   if (!(e.target as Element).closest('.mail, article.legal')) e.preventDefault();
      // });
    </script>
    <!-- Gruß für alle, die die Entwicklertools öffnen -->
    <script is:inline define:vars={{ hello: useT(lang)('console.hello'), mail: copy[lang].contact.mail }}>
      const accent = getComputedStyle(document.documentElement).getPropertyValue('--c-accent');
      console.log(`%c${hello} ${mail}`, `font: 700 20px sans-serif; color: ${accent}`);
    </script>
    <script src="../scripts/reveal.js"></script>
    <script src="../scripts/cursor.js"></script>
  </body>
</html>
